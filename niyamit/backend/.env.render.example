# Reference only. Enter these in Render > Environment, never commit real values.
# Render Root Directory: niyamit/backend; Docker Command: python -m app.render_start
APP_ENV=development
DEMO_MODE=true
SECRET_KEY=replace-with-a-new-stable-random-secret-at-least-32-characters
COOKIE_SECURE=true
# Replace after the FRONTEND is deployed (not the API URL).
PUBLIC_APP_URL=https://replace-with-frontend.onrender.com

# Supabase Connect > Session pooler (IPv4, port 5432). URL-encode the password.
# Use postgresql+psycopg:// instead of postgresql://, and require TLS.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Existing setting name accepts modern sb_secret_ keys and legacy service_role JWTs. Prefer a modern secret key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-supabase-secret-key
SUPABASE_STORAGE_BUCKET=niyamit-artifacts
STORAGE_TIMEOUT_SECONDS=30

# Single API process; no paid background worker or external Redis required.
TASKS_EAGER=true
INLINE_SCHEDULER=true
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMITS_ENABLED=true
TRUSTED_PROXY_HOPS=1
MAX_UPLOAD_MB=5
MAX_AUDIO_MB=3
MAX_PDF_PAGES=3
MAX_IMAGE_PIXELS=8000000
OMP_THREAD_LIMIT=1

# No billable providers by default. Use synthetic reports and test numbers only.
PATIENT_OTP_PROVIDER=development
LLM_PROVIDER=rules
DOC_PROVIDER=local
OCR_PROVIDER=local
ASR_PROVIDER=none
TTS_PROVIDER=none
WHATSAPP_ENABLED=false
