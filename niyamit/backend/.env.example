# =====================================================================================================
#  Niyamit Care Bridge: backend settings
#
#  1. Copy this file to backend/.env
#        macOS / Linux:   cp backend/.env.example backend/.env
#        Windows:         copy backend\.env.example backend\.env
#  2. Paste your keys on the two lines marked PASTE below (right after the = sign, no quotes, no spaces).
#  3. Restart:  docker compose up -d --build
#
#  backend/.env holds secrets. It is ignored by git and never copied into a Docker image. Do not share it.
# =====================================================================================================


# -----------------------------------------------------------------------------------------------------
# PASTE YOUR SARVAM AI KEY HERE  (recommended; powers Telugu / Hindi / English understanding,
# voice notes, read-aloud and document reading)
# Create one at https://indus.sarvam.ai/key-management  (API Keys, then copy it; it is shown only once)
SARVAM_API_KEY=

# PASTE YOUR OPENAI API KEY HERE  (optional; leave empty if you don't have one)
# A ChatGPT Plus subscription does NOT include API access. An API key comes from
# https://platform.openai.com/api-keys and is billed separately, pay-as-you-go.
OPENAI_API_KEY=
# -----------------------------------------------------------------------------------------------------


# A long random string. It signs logins and encrypts uploaded files. Make one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# If you change it later, files uploaded before the change can no longer be opened: reset the demo data
# (Test panel, as the admin) to load them again with the new key.
SECRET_KEY=replace-this-with-a-long-random-string

# Which service does each job. Without a key the app does not break: replies fall back to offline rules,
# documents to on-server OCR, and voice notes are switched off with a clear message to the patient.
# Understanding replies: sarvam | openai | rules
LLM_PROVIDER=sarvam
# Voice notes to text: sarvam | openai | none
ASR_PROVIDER=sarvam
# Reading replies aloud: sarvam | none
TTS_PROVIDER=sarvam
# Reading prescriptions and reports: sarvam | openai | local
DOC_PROVIDER=sarvam

# Demo mode: synthetic clinics, one-click demo logins, the simulated patient phone and the test panel.
DEMO_MODE=true
APP_ENV=development

# The address patients open from their messages. To try the patient app on a phone on the same Wi-Fi,
# use your laptop's IP address, for example http://192.168.1.20:3000 (typing and buttons work there; voice
# notes need localhost or HTTPS, because browsers only allow the microphone on secure pages).
PUBLIC_APP_URL=http://localhost:3000

# Database, Redis and file storage. Docker Compose sets these for you; change them only when you run
# the backend without Docker (see README, "Running without Docker").
DATABASE_URL=postgresql+psycopg://niyamit:niyamit@localhost:5432/niyamit
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./data/artifacts

# Optional: real WhatsApp through the Meta Cloud API. Leave disabled for the hackathon demo; messages
# then go to the simulated phone inside the app. Business-initiated reminders need a template that Meta
# has approved (WHATSAPP_REMINDER_TEMPLATE).
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REMINDER_TEMPLATE=

# Optional private Baidu OCR. Keep local until the model passes a real scan test.
OCR_PROVIDER=local
UNLIMITED_OCR_RUNTIME=vllm
UNLIMITED_OCR_BASE_URL=http://host.docker.internal:8001/v1
UNLIMITED_OCR_MODEL=baidu/Unlimited-OCR
UNLIMITED_OCR_TIMEOUT_SECONDS=120
# Local synthetic-record login only. Must be disabled in production.
PATIENT_OTP_PROVIDER=development
