# Niyamit Care Bridge: web app settings. No API keys go in this file: every key lives in backend/.env.
#
# Needed only when you run the web app without Docker (npm run dev). Copy it to frontend/.env.local.
# With Docker Compose this is already set for you.

# Where the Next.js server forwards /api/* requests (the FastAPI backend).
BACKEND_INTERNAL_URL=http://localhost:8000
